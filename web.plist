<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      OmniVoice Web — macOS user-level LaunchAgent
      ==============================================
      登录/开机后自动启动 web.py（uv run），崩溃自动重启。

      部署（user-level，仅当前用户）：
        cp web.plist ~/Library/LaunchAgents/com.omnivoice.web.plist
        launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.omnivoice.web.plist

      卸载 / 停止：
        launchctl bootout gui/$(id -u)/com.omnivoice.web
        rm ~/Library/LaunchAgents/com.omnivoice.web.plist

      日志：~/Library/Logs/omnivoice-web.{out,err}.log
      端口：默认 38001（可在此文件 EnvironmentVariables 加 OMNI_PORT 覆盖）
    -->
    <key>Label</key>
    <string>com.omnivoice.web</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>--project</string>
        <string>/Users/mod/workspace/tts-omnivoice</string>
        <string>python</string>
        <string>web.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mod/workspace/tts-omnivoice</string>

    <!-- 登录后自动启动 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 进程退出（崩溃）时自动拉起 -->
    <key>KeepAlive</key>
    <true/>

    <!-- 标准输出 / 错误日志 -->
    <key>StandardOutPath</key>
    <string>/Users/mod/Library/Logs/omnivoice-web.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mod/Library/Logs/omnivoice-web.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd 的 PATH 很精简，补上 uv 所在目录与常用路径 -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- 如需改端口/监听地址：OMNI_PORT / OMNIVOICE_WEB_IP -->
    </dict>
</dict>
</plist>
